    UPDATE: (id: string) => `/api/cameras/${id}`,
    DELETE: (id: string) => `/api/cameras/${id}`,
    STREAM: (id: string) => `/api/cameras/${id}/stream`,
    SNAPSHOT: (id: string) => `/api/cameras/${id}/snapshot`,
  },
  EVENTS: {
    LIST: "/api/events",
