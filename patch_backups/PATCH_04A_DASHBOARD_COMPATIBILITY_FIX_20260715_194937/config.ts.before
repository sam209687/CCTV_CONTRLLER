// ===================== NETWORK CONFIG =====================
export const NETWORK_CONFIG = {
  ANDROID_EMULATOR: "http://10.0.2.2:3000",
  IOS_SIMULATOR: "http://localhost:3000",
  LOCAL_NETWORK: "http://10.69.50.214:3000",
  PRODUCTION: "https://your-api.com",

  ACTIVE: getBaseURL(),
};

// ===================== HELPERS =====================
export const testAPIConnection = async (): Promise<boolean> => {
  try {
    const response = await fetch(
      `${API_CONFIG.BASE_URL}${API_ENDPOINTS.CAMERAS.LIST}`,
      {
        method: "GET",
        headers: { "Content-Type": "application/json" },
        signal: AbortSignal.timeout(5000),
      },
    );
    return response.ok;
  } catch (error) {
    console.error("API connection test failed:", error);
    return false;
  }
};

export const getCurrentAPIUrl = () => API_CONFIG.BASE_URL;

export const debugAPIConfig = () => {
  console.log("=== API Configuration Debug ===");
  console.log("Environment:", isDevelopment ? "Development" : "Production");
  console.log("Platform:", typeof window !== "undefined" ? "Web" : "Native");
  console.log("Base URL:", API_CONFIG.BASE_URL);
  console.log(
    "Cameras Endpoint:",
    `${API_CONFIG.BASE_URL}${API_ENDPOINTS.CAMERAS.LIST}`,
  );
  console.log("==============================");
};
