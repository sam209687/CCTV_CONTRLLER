// constants/config.ts

/**
 * API Configuration
 * IMPORTANT: Update BASE_URL based on your environment
 */

// ===================== ENV =====================
const isDevelopment = process.env.NODE_ENV === "development";

// ===================== BASE URL LOGIC =====================
export const getBaseURL = () => {
  // 1. Expo Web / Browser
  if (typeof window !== "undefined") {
    return "http://localhost:3000";
  }

  // 2. Native mobile (Android / iOS / Physical device)
  return "http://10.69.50.214:3000"; // ✅ Your computer IP
};

// ===================== API CONFIG =====================
export const API_CONFIG = {
  BASE_URL: getBaseURL(),
  TIMEOUT: 30000,
  RETRY_ATTEMPTS: 3,
  RETRY_DELAY: 1000,
};

// ===================== API ENDPOINTS =====================
