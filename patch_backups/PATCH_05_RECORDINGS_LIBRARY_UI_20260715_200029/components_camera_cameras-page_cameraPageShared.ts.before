// components/camera/cameras-page/cameraPageShared.ts

import { Dimensions, Platform, StyleSheet } from "react-native";

import type { Camera } from "@/types";

const { width } = Dimensions.get("window");
const isTablet = width >= 768;

const HIDDEN_CAMERAS_STORAGE_KEY = "cctv-hidden-camera-ids";

const DEMO_CAMERA_IDS = new Set([
  "mock-1",
  "mock-2",
  "mock-3",
  "cam-1",
  "cam-2",
]);

const DEMO_CAMERA_NAMES = new Set([
  "front door camera",
  "back entrance",
  "cash counter",
  "old android phone",
  "wifi cctv camera",
]);

export function readHiddenCameraIds(): string[] {
  if (Platform.OS !== "web" || typeof window === "undefined") {
    return [];
  }

  try {
    const savedValue = window.localStorage.getItem(
      HIDDEN_CAMERAS_STORAGE_KEY,
    );

    if (!savedValue) {
      return [];
    }

    const parsedValue: unknown = JSON.parse(savedValue);

    if (!Array.isArray(parsedValue)) {
      return [];
    }

    return parsedValue.filter(
      (cameraId): cameraId is string => typeof cameraId === "string",
    );
  } catch (error) {
    console.warn("Failed to read hidden cameras:", error);
    return [];
  }
}

export function saveHiddenCameraIds(cameraIds: string[]): void {
  if (Platform.OS !== "web" || typeof window === "undefined") {
    return;
  }

  try {
    window.localStorage.setItem(
      HIDDEN_CAMERAS_STORAGE_KEY,
      JSON.stringify(cameraIds),
    );
  } catch (error) {
    console.warn("Failed to save hidden cameras:", error);
  }
}

export function getCameraStreamValue(camera: Camera): string {
  return (camera.streamUrl || camera.rtspUrl || "").trim();
}

export function normalizePairingId(value: string): string {
  return value
    .trim()
    .replace(/^smartphone:/i, "")
    .trim();
}

export function getSmartphoneCameraId(camera: Camera): string {
  const streamValue = getCameraStreamValue(camera);

  if (/^smartphone:/i.test(streamValue)) {
    return normalizePairingId(streamValue);
  }

  if (/^cam-[a-z0-9-]+$/i.test(streamValue)) {
    return streamValue;
  }

  const databaseId = String(camera.id).trim();

  if (!streamValue && /^cam-[a-z0-9-]+$/i.test(databaseId)) {
    return databaseId;
  }

  return "";
}

export function getCameraReferenceId(camera: Camera): string {
  return getSmartphoneCameraId(camera) || String(camera.id);
}

export function hasUsableCameraStream(camera: Camera): boolean {
  const streamValue = getCameraStreamValue(camera);

  if (/^smartphone:/i.test(streamValue)) {
    return Boolean(normalizePairingId(streamValue));
  }

  if (/^https?:\/\//i.test(streamValue)) {
    return true;
  }

  if (/^rtsp:\/\//i.test(streamValue)) {
    return true;
  }

  if (/^cam-[a-z0-9-]+$/i.test(streamValue)) {
    return true;
  }

  return Boolean(getSmartphoneCameraId(camera));
}

export function buildCameraForPreview(camera: Camera): Camera {
  const streamValue = getCameraStreamValue(camera);

  if (/^smartphone:/i.test(streamValue)) {
    return {
      ...camera,
      streamUrl: `smartphone:${normalizePairingId(streamValue)}`,
    };
  }

  if (/^cam-[a-z0-9-]+$/i.test(streamValue)) {
    return {
      ...camera,
      streamUrl: `smartphone:${streamValue}`,
    };
  }

  if (streamValue) {
    return {
      ...camera,
      streamUrl: streamValue,
    };
  }

  const smartphoneCameraId = getSmartphoneCameraId(camera);

  if (smartphoneCameraId) {
    return {
      ...camera,
      streamUrl: `smartphone:${smartphoneCameraId}`,
    };
  }

  return camera;
}

export function isDemoPlaceholderCamera(camera: Camera): boolean {
  const id = String(camera.id).toLowerCase();
  const name = (camera.name || "").trim().toLowerCase();

  return DEMO_CAMERA_IDS.has(id) || DEMO_CAMERA_NAMES.has(name);
}

