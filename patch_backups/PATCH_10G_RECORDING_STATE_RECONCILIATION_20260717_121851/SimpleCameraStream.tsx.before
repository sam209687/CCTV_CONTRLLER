    fontWeight: "700",
    textAlign: "center",
  },

  overlay: {
    position: "absolute",
    top: 0,
    left: 0,
    right: 0,
    padding: 16,
  },

  statusBox: {
    padding: 12,
    borderRadius: 8,
    backgroundColor: "rgba(0,0,0,0.72)",
  },

  statusText: {
    color: "#FFFFFF",
    fontSize: 12,
    fontFamily: "monospace",
    marginBottom: 4,
  },

  recordingMessage: {
    color: "#FDE68A",
    fontSize: 11,
    marginTop: 6,
  },

  recordButton: {
    marginTop: 12,
    paddingVertical: 13,
    paddingHorizontal: 18,
